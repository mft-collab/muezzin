rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ---------------------------------------------------------
    // GLOBALS & HELPERS
    // ---------------------------------------------------------
    // email_verified zorunlu: istemci yalnizca Google ile giris yapiyor (her
    // zaman dogrulanmis e-posta doner), ama konsolda Email/Sifre gibi baska
    // bir saglayici acikken bu kontrol olmasaydi dogrulanmamis bir e-postayla
    // (ornegin bir superAdminEmails girdisini taklit ederek) kimlik sahtekarligi
    // mumkun olurdu (bkz. mimari denetim K1).
    function isSignedIn() {
      return request.auth != null && request.auth.uid != null &&
        request.auth.token.email_verified == true;
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // `cumaMi` opsiyonel bir alandır (bkz. isValidBildirim yorumu) — eski
    // belgelerde hiç yok. `data.cumaMi != true` alan tümüyle eksikken map
    // üzerinde tanımsız bir anahtara erişim hatası fırlatır (rules engine'i
    // "Property cumaMi is undefined on object" ile reddeder), bu da "eksikse
    // Cuma değil say" (fail-open) niyetinin TAM TERSİNİ üretiyordu — alan
    // eksik olan bildirimler mazeret/vekalet güncellemelerinde kalıcı olarak
    // reddediliyordu (bkz. mimari denetim regresyonu, test:rules ile
    // yakalandı). `.get(key, default)` kullanmak alan eksikliğini güvenle
    // ele alır.
    function cumaMiIsaretli(data) {
      return data.get('cumaMi', false) == true;
    }

    // Süper-admin e-postaları config/bootstrap dokümanında tutulur (kaynak kodda
    // gömülü değildir). Doküman yoksa veya alan eksikse boş liste varsayılır.
    function isSuperAdminEmail(email) {
      return email != null &&
        exists(/databases/$(database)/documents/config/bootstrap) &&
        email in get(/databases/$(database)/documents/config/bootstrap).data.get('superAdminEmails', []);
    }

    function isAdmin() {
      return isSignedIn() && (
        isSuperAdminEmail(request.auth.token.email) ||
        (exists(/databases/$(database)/documents/muezzins/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/muezzins/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // ---------------------------------------------------------
    // ENTITY: Duyurular
    // ---------------------------------------------------------
    // Diğer tüm yazılabilir varlıkların (muezzins, invites, vakitler,
    // bildirimler, vekalet_talepleri, error_logs, audit_logs,
    // telemetry_logs, settings, izinler) kendi şema doğrulayıcısı varken
    // duyurular hiç doğrulanmıyordu — yalnızca admin yazabildiğinden bir
    // yetki açığı değil, ama savunma derinliği tutarsızlığıydı (bkz. mimari
    // denetim — üçüncü tur). src/services/duyuruServisi.ts'in gerçek
    // create payload'ıyla (baslik, icerik, tip, tarih) birebir eşleşir;
    // `yazar` src/hooks/useDuyurular.ts'teki Duyuru tipinde opsiyonel
    // olarak tanımlı (henüz hiçbir yazım yolu kullanmıyor) — ileride
    // kullanılırsa reddedilmesin diye şemaya izinli alan olarak dahil edildi.
    function isValidDuyuru(data) {
      return data.keys().hasAll(['baslik', 'icerik', 'tip', 'tarih']) &&
             data.keys().hasOnly(['baslik', 'icerik', 'tip', 'tarih', 'yazar']) &&
             data.baslik is string && data.baslik.size() > 0 && data.baslik.size() <= 200 &&
             data.icerik is string && data.icerik.size() > 0 && data.icerik.size() <= 5000 &&
             data.tip in ['onemli', 'bilgi', 'duyuru'] &&
             data.tarih is timestamp &&
             // yazar diğer tüm serbest metin alanları (baslik, icerik) gibi
             // uzunluk sınırı olmadan bırakılmıştı — bugün yalnızca admin
             // yazabildiğinden sömürülebilir değil, ama bu alan ileride
             // (yorumda belirtildiği gibi) doldurulmaya başlarsa hiçbir şey
             // sınırsız uzunlukta bir değeri engellemiyordu (bkz. code-review,
             // dördüncü denetim turu).
             (!data.keys().hasAny(['yazar']) || (data.yazar is string && data.yazar.size() <= 100));
    }

    match /duyurular/{duyuruId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin() && isValidDuyuru(incoming());
      allow delete: if isAdmin();
    }

    // ENTITY: Muezzins
    function isValidMuezzin(data) {
      return data.keys().hasAll(['displayName', 'aktif', 'role', 'email']) &&
             data.keys().hasOnly([
               'displayName', 'aktif', 'role', 'email', 'photoURL', 'fcmToken', 'fcmTokens',
               'aylikVakitSayisi', 'aylikCumaSayisi', 'aylikYedekSayisi', 'yillikIzinKullanilanGun',
               'haftalikIzinGunu', 'notificationSettings',
               'onayBekliyor', 'kayitTarihi', 'arsivlendi', 'arsivTarihi'
             ]) &&
             data.displayName is string && data.displayName.size() <= 100 &&
             data.role in ['admin', 'muezzin', 'gozlemci'] &&
             data.email is string && data.email.size() <= 100 &&
             data.aktif is bool &&
             (!data.keys().hasAny(['photoURL']) || data.photoURL is string) &&
             (!data.keys().hasAny(['fcmToken']) || data.fcmToken is string || data.fcmToken == null) &&
             (!data.keys().hasAny(['fcmTokens']) || isValidFcmTokens(data.fcmTokens)) &&
             (!data.keys().hasAny(['aylikVakitSayisi']) || (data.aylikVakitSayisi is int && data.aylikVakitSayisi >= 0)) &&
             (!data.keys().hasAny(['aylikCumaSayisi']) || (data.aylikCumaSayisi is int && data.aylikCumaSayisi >= 0)) &&
             (!data.keys().hasAny(['aylikYedekSayisi']) || (data.aylikYedekSayisi is int && data.aylikYedekSayisi >= 0)) &&
             // Yıllık izin kotası (takvim yılı başına 30 gün) — bu üst sınır
             // SERT bir engeldir, admin de aşamaz (kullanıcı kararı). Sayaç
             // her 1 Ocak'ta scripts/yatsiSonuIslemleri.ts tarafından
             // sıfırlanır (bkz. src/store/useAdminIzinlerStore.ts izinGuncelle).
             (!data.keys().hasAny(['yillikIzinKullanilanGun']) || (data.yillikIzinKullanilanGun is int && data.yillikIzinKullanilanGun >= 0 && data.yillikIzinKullanilanGun <= 30)) &&
             // 5 (Cuma) hariç — PersonelFormModal.tsx bu seçeneği bilinçli
             // olarak devre dışı bırakır çünkü planlamaCekirdegi.ts
             // haftalikIzinGunu'nu kalıcı bir "bu kişi asla Cuma'ya
             // atanmaz" dışlaması olarak kullanır (bkz. isFixedDayOff);
             // sunucu tarafında bu kısıt yoktu (bkz. mimari denetim).
             (!data.keys().hasAny(['haftalikIzinGunu']) || (data.haftalikIzinGunu is int && data.haftalikIzinGunu >= 0 && data.haftalikIzinGunu <= 7 && data.haftalikIzinGunu != 5)) &&
             (!data.keys().hasAny(['notificationSettings']) || isValidNotificationSettings(data.notificationSettings)) &&
             (!data.keys().hasAny(['onayBekliyor']) || data.onayBekliyor is bool) &&
             (!data.keys().hasAny(['kayitTarihi']) || data.kayitTarihi is string) &&
             (!data.keys().hasAny(['arsivlendi']) || data.arsivlendi is bool) &&
             (!data.keys().hasAny(['arsivTarihi']) || data.arsivTarihi == null || data.arsivTarihi is timestamp);
    }

    function isValidNotificationSettings(settings) {
      return settings is map &&
             settings.keys().hasOnly(['nobetHatirlatici', 'duyurular', 'mazeretDurumu']) &&
             (!settings.keys().hasAny(['nobetHatirlatici']) || settings.nobetHatirlatici is bool) &&
             (!settings.keys().hasAny(['duyurular']) || settings.duyurular is bool) &&
             (!settings.keys().hasAny(['mazeretDurumu']) || settings.mazeretDurumu is bool);
    }

    function isValidFcmTokens(tokens) {
      return tokens is map && tokens.size() <= 20;
    }

    function isInvitedSelfMuezzinCreate(uid) {
      let emailId = request.auth.token.email.lower();
      let invite = get(/databases/$(database)/documents/invites/$(emailId)).data;
      return isSignedIn() &&
             request.auth.uid == uid &&
             incoming().email == emailId &&
             exists(/databases/$(database)/documents/invites/$(emailId)) &&
             incoming().role == invite.role &&
             // İstemci (useAuthStore.ts) kendi profilini oluştururken admin
             // rolü hariç her zaman onayBekliyor:true yazar — bu kısıt
             // olmadan kişi kendi profilini onayBekliyor:false ile
             // oluşturup admin onayı beklemeden doğrudan nöbete
             // atanabiliyordu (bkz. mimari denetim Y4).
             (incoming().role == 'admin' ? incoming().get('onayBekliyor', false) != true : incoming().get('onayBekliyor', false) == true);
    }

    match /muezzins/{uid} {
      allow get, list: if isSignedIn();
      allow create: if isValidMuezzin(incoming()) && (isAdmin() || isInvitedSelfMuezzinCreate(uid));
      allow delete: if isAdmin();
      allow update: if isSignedIn() && isValidMuezzin(incoming()) && (
        isAdmin() || (
            request.auth.uid == uid && 
            incoming().email == existing().email && 
            incoming().role == existing().role &&
            incoming().aktif == existing().aktif &&
            incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'fcmToken', 'fcmTokens', 'notificationSettings']) &&
            (!incoming().keys().hasAny(['notificationSettings']) || isValidNotificationSettings(incoming().notificationSettings)) &&
            (!incoming().keys().hasAny(['fcmTokens']) || isValidFcmTokens(incoming().fcmTokens))
        )
      );
    }

    // ---------------------------------------------------------
    // ENTITY: Invites
    // ---------------------------------------------------------
    function isValidInvite(data) {
      return data.keys().hasAll(['email', 'role']) &&
             data.keys().hasOnly(['email', 'displayName', 'role', 'haftalikIzinGunu', 'olusturmaTarihi']) &&
             data.email is string && data.email.size() <= 100 &&
             data.role in ['admin', 'muezzin', 'gozlemci'] &&
             (!data.keys().hasAny(['displayName']) || (data.displayName is string && data.displayName.size() <= 100)) &&
             // isValidMuezzin ile aynı Cuma (5) hariç tutması — bu alan
             // kabul edilecek daveti self-registration'da doğrudan
             // muezzins doc'una kopyalanır (bkz. useAuthStore.ts).
             (!data.keys().hasAny(['haftalikIzinGunu']) || (data.haftalikIzinGunu is int && data.haftalikIzinGunu >= 1 && data.haftalikIzinGunu <= 7 && data.haftalikIzinGunu != 5));
    }

    match /invites/{emailId} {
      allow list: if isAdmin();
      allow get: if isSignedIn() && (isAdmin() || request.auth.token.email.lower() == emailId.lower());
      allow create, update: if isAdmin() && isValidInvite(incoming()) && incoming().email.lower() == emailId.lower();
      allow delete: if isAdmin() || (isSignedIn() && request.auth.token.email.lower() == emailId.lower());
    }

    // ---------------------------------------------------------
    // ENTITY: Vakitler
    // ---------------------------------------------------------
    function isValidVakitCache(data) {
      return data.keys().hasAll(['ilceId', 'gunler', 'kaynakApi', 'guncellenmeTarihi']) &&
             data.keys().hasOnly(['ilceId', 'gunler', 'kaynakApi', 'guncellenmeTarihi']) &&
             data.ilceId is string && data.ilceId.size() >= 3 && data.ilceId.size() <= 8 &&
             data.ilceId.matches('^[0-9]+$') &&
             // Alt sınır önceden 28'di ("her zaman tam bir ay yazılır" varsayımı) ama
             // src/services/ezanVaktiServisi.ts aylikVakitleriGrupla, API'nin bugünden
             // itibaren döndürdüğü kayan pencereyi gerçek takvim ayına göre böldüğünden,
             // İÇİNDE BULUNULAN ay için kasıtlı olarak PARTIAL bir grup üretir (ör. ayın
             // 10'unda senkronize edilirse o ay yalnızca ~20 gün içerir). Bu, ilk kez
             // senkronize edilen bir ilçede (bkz. SistemAyarlari.tsx ilçe değişikliği)
             // ayın neredeyse HER gününde bu yazımı reddediyordu (bkz. mantık denetimi).
             data.gunler is map && data.gunler.size() >= 1 && data.gunler.size() <= 32 &&
             data.kaynakApi in ['diyanet', 'aladhan'] &&
             data.guncellenmeTarihi is timestamp;
    }

    match /vakitler/{docId} {
      allow get, list: if isSignedIn();
      allow write: if isAdmin() && isValidVakitCache(incoming());
    }

    // ---------------------------------------------------------
    // ENTITY: Hafta Planları
    // ---------------------------------------------------------
    match /haftaPlanlari/{docId} {
      allow read, list: if isSignedIn();
      allow create, delete: if isAdmin();
      // Only admins can update the plan. Swaps should be handled via a secure process.
      allow update: if isAdmin(); 
    }

    // ---------------------------------------------------------
    // ENTITY: Bildirimler
    // ---------------------------------------------------------
    // NOT (mimari denetim Y3): `isAssignableDutyUid()` en sona taşındı.
    // `bildirimler` update kuralı bunun gibi 4 ağır dalı OR'lar (bkz. altta
    // `allow update`); her dal önce pahalı bir Firestore get() ile başlarsa
    // toplam ifade sayısı emülatörün 1000 ifade tavanına çarpabiliyordu ("K2:
    // devirSonucu sema disi bir deger olamaz" ve "vekalet alicisi kabul
    // etmeden bildirimi devralamaz" testleri bu yüzden doğru kural mantığıyla
    // değil kaynak tükenmesiyle geçiyordu). CEL `&&` soldan sağa kısa devre
    // yaptığından, ucuz alan eşitlikleri (özellikle `existing().uid ==
    // request.auth.uid` — başkasının belgesini güncellemeye çalışan HER
    // istek burada hiç Firestore okumadan elenir) en başta, pahalı
    // `isAssignableDutyUid()` çağrısı en sonda olmalı.
    // `existing().uid == request.auth.uid` sarmalayıcı bir FONKSİYON ÇAĞRISI
    // sınırında kontrol edilir (ayrı bir `let` değil) — bildirimler
    // update kuralı aynı transaction içinde İKİ belgeyi (asil+yedek)
    // güncelleyebildiğinden (bkz. mazeretBildir), yedek belgenin update'i
    // için bu fonksiyon çağrıldığında `existing().uid != request.auth.uid`
    // olduğundan buradaki `&&` HİÇ isSelfBildirimUpdateIcin'e girmeden
    // kısa devre yapar — içindeki `getAfter(mazeret_detaylari/...)` ve
    // `incoming().diff(existing())` gibi pahalı işlemler o belge için hiç
    // çalışmaz. Bu ayrım eklenmeden önce (blanket `let` fonksiyonun en
    // başında), aynı transaction'daki 2 bildirimler yazımı + yeni
    // mazeret_detaylari yazımının TOPLAM ifade sayısı emülatörün 1000
    // ifade tavanını aşıp mazeret bildirimini üretimde kırıyordu (bkz.
    // mimari denetim — altıncı tur, E2E regresyonu).
    function isSelfBildirimUpdate(docId) {
      return existing().uid == request.auth.uid && isSelfBildirimUpdateIcin(docId);
    }

    function isSelfBildirimUpdateIcin(docId) {
      let changed = incoming().diff(existing()).affectedKeys();
      // devirSonucu opsiyonel alan (bkz. isValidBildirim) — mazeret
      // reddi/onayı dışındaki hiçbir bildirimde hiç set edilmemiş olabilir.
      // `.get(key, default)` ile okunmazlarsa alan tümüyle eksikken doğrudan
      // `incoming().devirSonucu` erişimi rules motorunda "Property is
      // undefined" hatası fırlatıyordu (bkz. `cumaMiIsaretli`/
      // `isBackupPromotionFromMazeret` ile aynı kalıp).
      let devirSonucu = incoming().get('devirSonucu', null);
      // mazeret_detaylari koleksiyonunda BU belgeyle AYNI ID'ye (docId —
      // match bloğunun kendi wildcard'ı, isAcceptedVekaletBildirimTransfer
      // ile aynı desen) sahip bir kayıt, reddi bildiren tarafın özel
      // mazeret gerekçesini (retSebebi) taşır. Önceden retSebebi doğrudan
      // BU belgede (bildirimler) tutuluyordu; bildirimler `allow read, list:
      // if isSignedIn()` ile (haftalık çizelgeyi TÜM ekibin görebilmesi
      // için GEREKLİ) açık kalmak zorunda olduğundan, bu da retSebebi'yi
      // istemeden herkese açıyordu — normal haftalık çizelge sorgusunda
      // bile pasif olarak sızıyordu, ve admin-only "Mazeret Geçmişi"
      // ekranının sorgusu herhangi bir kullanıcı tarafından konsoldan
      // birebir tekrarlanabiliyordu (bkz. mimari denetim — altıncı tur).
      // retSebebi artık ayrı, yalnızca ilgili kişi+admin'in okuyabildiği
      // mazeret_detaylari koleksiyonuna taşındı; isBackupPromotionFromMazeret'teki
      // desenle SİMETRİK bir getAfter() korelasyonu bu belgenin GERÇEKTEN
      // aynı commit'te yazıldığını doğrular (eşleşen belge yoksa/uid
      // uyuşmazsa değerlendirme hatasıyla fail-closed reddeder — dosyada
      // zaten kurulu bir desen). NOT: docId, bildirimler'in kendi
      // belgesinin GERÇEK ID'sidir — üretimde her zaman deterministik
      // (haftaId_tarih_vakit_tip) olsa da, bu alanlardan yeniden hesaplamak
      // yerine doğrudan kullanmak daha güvenilir (ör. test fixture'ları
      // gibi bu kalıba uymayan ID'lerde de doğru çalışır).
      let mazeretDetay = getAfter(/databases/$(database)/documents/mazeret_detaylari/$(docId)).data;
      return existing().uid == request.auth.uid &&
             incoming().uid == existing().uid &&
             incoming().haftaId == existing().haftaId &&
             incoming().tarih == existing().tarih &&
             incoming().vakit == existing().vakit &&
             incoming().tip == existing().tip &&
             changed.hasOnly(['durum', 'pendingAck', 'sonGuncelleme', 'devirSonucu']) &&
             // Diğer zaman damgası alanları gibi (bkz. isValidBildirim)
             // sonGuncelleme burada da tiplenmemişti — gerçek çağıranlar
             // zaten serverTimestamp() gönderiyor ama sema doğrulaması
             // tutarlı olmalı (bkz. mimari denetim — üçüncü tur).
             incoming().sonGuncelleme is timestamp &&
             (
               (
                 existing().durum == 'bekliyor' &&
                 incoming().durum == 'onaylandi' &&
                 incoming().pendingAck == false &&
                 !changed.hasAny(['devirSonucu'])
               ) ||
               (
                 existing().durum == 'bekliyor' &&
                 existing().tip == 'asil' &&
                 // Cuma gunleri mazeret/gorev devri kullanilamaz (bkz. ayni
                 // kisitlamanin izin taleplerindeki karsiligi:
                 // src/components/VacationRequestCard.tsx ve istemci tarafi
                 // ayna kural: src/lib/mazeretKurallari.ts).
                 !cumaMiIsaretli(existing()) &&
                 incoming().durum == 'reddedildi' &&
                 incoming().pendingAck == false &&
                 mazeretDetay.uid == request.auth.uid &&
                 (
                   devirSonucu == 'alarm_bekliyor' ||
                   // Önceden `devirSonucu == 'yedek_atandi'` bu TEK belge
                   // güncellemesinde hiçbir şekilde doğrulanmıyordu — yedeğin
                   // GERÇEKTEN terfi ettiğini gösteren eşleşen bir yazım aynı
                   // commit'te olmasa bile bu değer kabul ediliyordu.
                   // src/services/mazeretServisi.ts (mazeretBildir) ikisini
                   // her zaman AYNI transaction'da yazsa da, bu kuralı
                   // atlayıp doğrudan updateDoc çağıran biri yedek belgesini
                   // hiç terfi ettirmeden "yedek_atandi" diyebiliyordu —
                   // scripts/mazeretDevirleriniIsle.ts bu durumda sessizce
                   // atlıyor (ne admin alarmı ne mazeretPlanSenkronEdildi),
                   // vakit kapsamsız kalıyor ama "halledildi" sanılıyordu
                   // (bkz. mimari denetim — üçüncü tur). isBackupPromotionFromMazeret
                   // ile simetrik: yedeğin deterministik belge ID'si
                   // (haftaId_tarih_vakit_yedek) üzerinden bu COMMIT'te
                   // gerçekten 'asil'e terfi ettiği getAfter() ile doğrulanır.
                   (devirSonucu == 'yedek_atandi' &&
                    getAfter(/databases/$(database)/documents/bildirimler/$(existing().haftaId + '_' + existing().tarih + '_' + existing().vakit + '_yedek')).data.tip == 'asil')
                 )
               ) ||
               (
                 // Yedek görevli kendi mazeretini bildiriyor — devralacak bir
                 // "yedeğin yedeği" olmadığından doğrudan admin alarmına
                 // düşer (bkz. src/services/mazeretServisi.ts, scripts/
                 // mazeretDevirleriniIsle.ts).
                 existing().durum == 'bekliyor' &&
                 existing().tip == 'yedek' &&
                 !cumaMiIsaretli(existing()) &&
                 incoming().durum == 'reddedildi' &&
                 incoming().pendingAck == false &&
                 mazeretDetay.uid == request.auth.uid &&
                 devirSonucu == 'alarm_bekliyor'
               )
             ) &&
             isAssignableDutyUid(request.auth.uid);
    }

    // Bir müezzin mazeret bildirdiğinde (yukarıdaki reddedildi geçişi), aynı
    // transaction içinde -- eğer uygun bir yedek varsa -- yedeğin kendi
    // bildirim belgesi 'asil' rolüne terfi eder. Bildirim ID'leri deterministik
    // olduğundan (haftaId_tarih_vakit_tip), yedek belgesi kendi alanlarından
    // asil belgesinin yolunu hesaplayıp getAfter() ile o belgenin bu
    // transaction'da gerçekten 'reddedildi' durumuna geçtiğini doğrulayabilir.
    // NOT (mimari denetim Y3): `isAssignableDutyUid()` en sona taşındı (bkz.
    // isSelfBildirimUpdate/isAcceptedVekaletBildirimTransfer yorumları — aynı
    // gerekçe). Ayrıca `incoming().asilMazeretUid` artık `.get(..., '')` ile
    // okunuyor: bu fonksiyon `bildirimler` update kuralındaki OR zincirinin
    // SON dalı olduğundan, önceki dallara uymayan HER güncelleme isteği
    // (asilMazeretUid alanı hiç göndermeyenler dahil) buraya kadar
    // düşebiliyordu — alan tamamen eksikken doğrudan `.asilMazeretUid`
    // erişimi rules motorunda "Property is undefined" hatası fırlatıyordu
    // (bkz. `cumaMiIsaretli` ile aynı kalıp, aynı kök neden).
    // NOT (ifade tavanı denetimi): `existing()/incoming()` alan karşılaştırması
    // olan ucuz bir ön-kontrol, `getAfter()` içeren pahalı gövdeyi AYRI bir
    // fonksiyona taşıdı — isSelfBildirimUpdate'teki AYNI teknik (bkz. o
    // yorum). Önceden `let asilAfter = getAfter(...)` bu fonksiyonun EN
    // BAŞINDAydı; CEL'de `let` bağlamaları fonksiyon girişinde HEMEN
    // değerlendirildiğinden, `bildirimler` update kuralının OR zincirindeki
    // diğer 3 dal (isAdmin/isValidBildirim, isSelfBildirimUpdate,
    // isAcceptedVekaletBildirimTransfer) tutmayan HER güncelleme isteğinde bu
    // fonksiyon da çağrılıyor ve `getAfter()` hiç ilgisi olmasa bile
    // çalışıyordu — dört dalın toplamı emülatörün 1000 ifade tavanını
    // aşıyordu (bkz. `npm run test:rules` çıktısındaki "Unable to evaluate
    // the expression as the maximum of 1000 expressions" uyarıları).
    function isBackupPromotionFromMazeret() {
      return existing().tip == 'yedek' &&
             incoming().tip == 'asil' &&
             incoming().uid == existing().uid &&
             isBackupPromotionFromMazeretIcin();
    }

    function isBackupPromotionFromMazeretIcin() {
      let changed = incoming().diff(existing()).affectedKeys();
      let asilDocId = existing().haftaId + '_' + existing().tarih + '_' + existing().vakit + '_asil';
      let asilAfter = getAfter(/databases/$(database)/documents/bildirimler/$(asilDocId)).data;
      return isSignedIn() &&
             existing().durum != 'reddedildi' &&
             existing().uid != request.auth.uid &&
             incoming().durum == 'bekliyor' &&
             incoming().pendingAck == true &&
             incoming().haftaId == existing().haftaId &&
             incoming().tarih == existing().tarih &&
             incoming().vakit == existing().vakit &&
             incoming().get('asilMazeretUid', '') == request.auth.uid &&
             changed.hasOnly(['tip', 'durum', 'pendingAck', 'sonGuncelleme', 'asilMazeretUid']) &&
             incoming().sonGuncelleme is timestamp &&
             asilAfter.tip == 'asil' &&
             asilAfter.durum == 'reddedildi' &&
             asilAfter.uid == request.auth.uid &&
             asilAfter.haftaId == existing().haftaId &&
             asilAfter.tarih == existing().tarih &&
             asilAfter.vakit == existing().vakit &&
             asilAfter.devirSonucu == 'yedek_atandi' &&
             isAssignableDutyUid(existing().uid);
    }

    function vekaletTalepId(data) {
      return data.haftaId + '_' + data.tarih + '_' + data.vakit + '_' + data.tip + '_' + data.aliciUid;
    }

    function isVekaletParticipant(data) {
      return isSignedIn() && (data.gonderenUid == request.auth.uid || data.aliciUid == request.auth.uid);
    }

    function isValidVekaletTalebi(data) {
      return data.keys().hasAll([
               'bildirimId', 'haftaId', 'gonderenUid', 'gonderenIsim',
               'aliciUid', 'aliciIsim', 'tarih', 'vakit', 'saat',
               'tip', 'durum', 'olusturmaTarihi'
             ]) &&
             data.keys().hasOnly([
               'bildirimId', 'haftaId', 'gonderenUid', 'gonderenIsim',
               'aliciUid', 'aliciIsim', 'tarih', 'vakit', 'saat',
               'tip', 'durum', 'olusturmaTarihi', 'sonGuncelleme'
             ]) &&
             data.bildirimId is string &&
             data.haftaId is string &&
             data.gonderenUid == request.auth.uid &&
             data.gonderenIsim is string && data.gonderenIsim.size() > 0 && data.gonderenIsim.size() <= 120 &&
             data.aliciUid is string && data.aliciUid != request.auth.uid &&
             data.aliciIsim is string && data.aliciIsim.size() > 0 && data.aliciIsim.size() <= 120 &&
             data.tarih is string && data.tarih.size() == 10 &&
             data.vakit in ['sabah', 'ogle', 'ikindi', 'aksam', 'yatsi'] &&
             data.saat is string && data.saat.size() >= 4 && data.saat.size() <= 5 &&
             data.tip in ['asil', 'yedek', 'gorev_cagrisi'] &&
             data.durum == 'beklemede';
    }

    function isValidVekaletCreate(talepId) {
      let bildirim = get(/databases/$(database)/documents/bildirimler/$(incoming().bildirimId)).data;
      let alici = get(/databases/$(database)/documents/muezzins/$(incoming().aliciUid)).data;
      return isValidVekaletTalebi(incoming()) &&
             talepId == vekaletTalepId(incoming()) &&
             bildirim.uid == request.auth.uid &&
             bildirim.haftaId == incoming().haftaId &&
             bildirim.tarih == incoming().tarih &&
             bildirim.vakit == incoming().vakit &&
             bildirim.tip == incoming().tip &&
             bildirim.durum == 'bekliyor' &&
             // Cuma gorevleri vekalet ile de devredilemez — aksi halde
             // mazeret icin uygulanan Cuma kisitlamasi bu yoldan atlatilabilir
             // (bkz. algoritma denetimi).
             !cumaMiIsaretli(bildirim) &&
             alici.role == 'muezzin' &&
             alici.aktif == true;
    }

    function isRecipientVekaletStatusUpdate() {
      let changed = incoming().diff(existing()).affectedKeys();
      return isSignedIn() &&
             existing().aliciUid == request.auth.uid &&
             existing().durum == 'beklemede' &&
             incoming().diff(existing()).unchangedKeys().hasAll([
               'bildirimId', 'haftaId', 'gonderenUid', 'gonderenIsim',
               'aliciUid', 'aliciIsim', 'tarih', 'vakit', 'saat',
               'tip', 'olusturmaTarihi'
             ]) &&
             changed.hasOnly(['durum', 'sonGuncelleme']) &&
             incoming().durum in ['kabul_edildi', 'reddedildi'];
    }

    // NOT (ifade tavanı denetimi): isBackupPromotionFromMazeret ile AYNI
    // teknik — ucuz, salt `existing()/incoming()` alan karşılaştırmalarından
    // oluşan bir ön-kontrol, `getAfter()` içeren pahalı gövdeyi ayrı bir
    // fonksiyona taşıdı. Önceden `let talep = getAfter(...)` doğrudan bu
    // fonksiyonun (OR zincirinin bir dalının) en başındaydı ve `bildirimler`
    // update kuralına uymayan HER istekte (diğer 3 dal tutmasa bile)
    // koşulsuz çalışıyordu — dört dalın toplam ifade sayısı emülatörün 1000
    // tavanını aşıyordu (bkz. isBackupPromotionFromMazeret yorumu).
    function isAcceptedVekaletBildirimTransfer(bildirimId) {
      return existing().durum == 'bekliyor' &&
             existing().uid != request.auth.uid &&
             incoming().uid == request.auth.uid &&
             isAcceptedVekaletBildirimTransferIcin(bildirimId);
    }

    // NOT (mimari denetim Y3): `isAssignableDutyUid()` en sona taşındı — ucuz
    // `existing()`/`incoming()` alan karşılaştırmaları önce elenir, ek
    // Firestore okuması gerektiren doğrulama en son (bkz. isSelfBildirimUpdate
    // yorumu). `talep.*` karşılaştırmaları zaten fonksiyon girişindeki
    // `let talep = getAfter(...)`'e bağımlı olduğundan (bu okuma sıralamadan
    // bağımsız olarak zaten gerçekleşir) sıraları performansı etkilemez.
    // ifade tavanı denetimi: alıcının muezzins belgesi burada VE
    // isAssignableDutyUid() içinde AYRI AYRI get() ediliyordu (aynı yol,
    // aynı transaction). Tek `let` ile bir kez okunup hem
    // isAssignableDutyUidVeri()'ye hem Cuma-izin kontrolüne aktarılıyor —
    // bu dalın kendi (zaten pahalı: talep getAfter + diff + get) ifade
    // maliyetini bir get() kadar düşürür.
    function isAcceptedVekaletBildirimTransferIcin(bildirimId) {
      let talepId = existing().haftaId + '_' + existing().tarih + '_' + existing().vakit + '_' + existing().tip + '_' + request.auth.uid;
      let talep = getAfter(/databases/$(database)/documents/vekalet_talepleri/$(talepId)).data;
      let changed = incoming().diff(existing()).affectedKeys();
      let aliciMuezzinDoc = /databases/$(database)/documents/muezzins/$(request.auth.uid);
      let aliciMuezzinVeri = exists(aliciMuezzinDoc) ? get(aliciMuezzinDoc).data : null;
      return !cumaMiIsaretli(existing()) &&
             incoming().durum == existing().durum &&
             incoming().haftaId == existing().haftaId &&
             incoming().tarih == existing().tarih &&
             incoming().vakit == existing().vakit &&
             incoming().tip == existing().tip &&
             incoming().pendingAck == existing().pendingAck &&
             // vekaletDevredildi: true zorunlu — durum bu gecişte degismedigi
             // icin (hala 'bekliyor' olabilir), bu isaret olmadan bir sonraki
             // plan yeniden uretimi bu slotu korumasiz sanip sessizce eski
             // sahibine geri dondurebiliyordu (bkz. mimari denetim K5).
             incoming().get('vekaletDevredildi', false) == true &&
             changed.hasOnly(['uid', 'vekaletDevredildi', 'sonGuncelleme']) &&
             incoming().sonGuncelleme is timestamp &&
             talep.bildirimId == bildirimId &&
             talep.haftaId == existing().haftaId &&
             talep.tarih == existing().tarih &&
             talep.vakit == existing().vakit &&
             talep.tip == existing().tip &&
             talep.gonderenUid == existing().uid &&
             talep.aliciUid == request.auth.uid &&
             talep.durum == 'kabul_edildi' &&
             // Talep oluşturulduğunda alıcının aktif müezzin olduğu
             // doğrulanmıştı (isValidVekaletCreate), ama talep beklerken
             // admin alıcıyı arşivleyebilir/rolünü değiştirebilir — kabul
             // anında TEKRAR doğrulanmazsa arşivlenmiş biri çizelgeye geri
             // dönebiliyordu (bkz. mimari denetim O9).
             isAssignableDutyUidVeri(request.auth.uid, aliciMuezzinVeri) &&
             // Sabit haftalık izin gününde asla atama yok kısıtlaması
             // (isValidBildirim'deki karşılığı) admin create/manuel-update
             // yolunda uygulanıyordu ama vekalet KABUL yolu bunu hiç
             // kontrol etmiyordu — biri kendi izin gününe denk gelen bir
             // nöbeti vekaletle "kabul ederek" bu kısıtlamayı atlatabiliyordu
             // (bkz. Cuma kısıtlaması için CLAUDE.md'nin uyardığı aynı desen:
             // üç yerde de senkron tutulmalı). `existing().tip` zaten
             // `talep.tip` ile eşleşmesi zorunlu tutulduğundan tekrar
             // kontrol edilmiyor. `isAssignableDutyUidVeri` yukarıda `&&`
             // ile önce geldiğinden, aliciMuezzinVeri null ise burası hiç
             // değerlendirilmeden kısa devre yapar.
             !(existing().tip in ['asil', 'yedek'] &&
               aliciMuezzinVeri.get('haftalikIzinGunu', 0) == haftaGunuNumarasi(existing().tarih));
    }

    // NOT (ifade tavanı denetimi): `get(muezzinDoc)` tek bir `let`'e alındı —
    // önceden aynı doküman için 3 ayrı `get()` çağrısı vardı (role, aktif,
    // onayBekliyor), üstelik bu fonksiyon `bildirimler` update kuralındaki
    // 4 dalın HER birinden çağrılıyor (bkz. isSelfBildirimUpdate yorumu, aynı
    // dosyada zaten belgeli 1000-ifade tavanı riski). `exists(muezzinDoc)`
    // hâlâ && ile önce kısa devre yapıyor — CEL koşullu (`?:`) ifadeler yalnız
    // seçilen dalı değerlendirdiğinden, doküman yoksa `get()` hiç çalışmıyor.
    function isAssignableDutyUid(uid) {
      let muezzinDoc = /databases/$(database)/documents/muezzins/$(uid);
      let muezzinVeri = exists(muezzinDoc) ? get(muezzinDoc).data : null;
      return isAssignableDutyUidVeri(uid, muezzinVeri);
    }

    // isAssignableDutyUid'in get()'siz hali — çağıran taraf muezzins verisini
    // başka bir sebeple (ör. isAcceptedVekaletBildirimTransferIcin'deki Cuma-
    // izin kontrolü) zaten okumuşsa AYNI belgeyi ikinci kez get() etmeden bu
    // fonksiyona doğrudan veriyi geçebilir — ifade tavanına yakın dallarda
    // tekrarlanan get() maliyetini önler.
    function isAssignableDutyUidVeri(uid, muezzinVeri) {
      return uid is string &&
             muezzinVeri != null &&
             muezzinVeri.role == 'muezzin' &&
             muezzinVeri.aktif == true &&
             // onayBekliyor: true olan (admin henüz onaylamamış) bir davetli
             // nöbete atanabilir sayılmamalı — AuthGuard ona zaten bir
             // bekleme ekranı gösterdiğinden, atandığı vakit kimse
             // göremiyordu (bkz. mimari denetim Y4).
             muezzinVeri.get('onayBekliyor', false) != true;
    }

    // Bir "YYYY-MM-DD" tarihinin haftanın hangi gününe denk geldiğini
    // haftalikIzinGunu ile AYNI ölçekte (Pazartesi=1 ... Pazar=7) döner.
    // epochGunSayisi mod 7'si 0 olması Perşembe demek (1970-01-01 bir
    // Perşembe, bkz. izinAraligiCumaIceriyorMu yorumu) — bu, Pazartesi
    // tabanlı 1-7 ölçeğine kaydırılır. `kisiGunIcinMusaitMi` (dateUtils.ts)
    // ve planlamaCekirdegi.ts'teki `gunIndex + 1` ile aynı sonucu üretir.
    function haftaGunuNumarasi(tarihStr) {
      let gun = ((epochGunSayisi(tarihStr) % 7) + 7) % 7;
      return ((gun + 3) % 7) + 1;
    }

    function isValidBildirim(data) {
      return data.keys().hasAll(['haftaId', 'tarih', 'vakit', 'uid', 'tip', 'durum', 'pendingAck', 'olusturmaTarihi', 'sonGuncelleme']) &&
             data.keys().hasOnly(['haftaId', 'tarih', 'vakit', 'uid', 'tip', 'durum', 'pendingAck', 'retSebebi', 'olusturmaTarihi', 'sonGuncelleme', 'devirSonucu', 'asilMazeretUid', 'mazeretPlanSenkronEdildi', 'vekaletPlanSenkronEdildi', 'cumaMi', 'vekaletDevredildi']) &&
             data.haftaId is string &&
             data.tarih is string && data.tarih.size() == 10 &&
             data.vakit in ['sabah', 'ogle', 'ikindi', 'aksam', 'yatsi'] &&
             isAssignableDutyUid(data.uid) &&
             // Sabit haftalık izin gününde asla atama yok — planlamaCekirdegi.ts
             // (otomatik motor) bunu mutlak sayar, ama admin'in manuel atama
             // yolu (HaftalikCizelge.tsx vakitAtamasiniGuncelle) sunucu
             // tarafında hiç doğrulanmıyordu (bkz. mimari denetim). Onaylı
             // izin KAPSAMI ayrı bir kısıttır ama "bu uid'in bugünü kapsayan
             // onaylı bir izni var mı" sorusu bir koleksiyon sorgusu
             // gerektirir — Security Rules yalnızca bilinen TEK bir doküman
             // yoluna get() yapabilir, sorgu çalıştıramaz; bu yüzden yalnızca
             // muezzins doc'unun kendi haftalikIzinGunu alanı (tek bilinen
             // yoldan get() edilebilir) burada uygulanabiliyor — izin kapsamı
             // istemci tarafı hard-block'a kalıyor.
             !(data.tip in ['asil', 'yedek'] &&
               get(/databases/$(database)/documents/muezzins/$(data.uid)).data.get('haftalikIzinGunu', 0) == haftaGunuNumarasi(data.tarih)) &&
             data.tip in ['asil', 'yedek', 'gorev_cagrisi'] &&
             data.durum in ['bekliyor', 'onaylandi', 'reddedildi', 'sistem_atadi', 'iptal', 'okundu_varsayilan'] &&
             data.pendingAck is bool &&
             // Diğer tüm zaman damgası alanları (isValidVakitCache
             // guncellenmeTarihi, isValidErrorLog/isValidTelemetryLog
             // timestamp) `is timestamp` ile tiplenirken bu ikisi hiç
             // kontrol edilmiyordu — tüm gerçek çağıranlar serverTimestamp()
             // gönderse de bu şema doğrulayıcısını çağıran yollarda (create,
             // admin update) teorik olarak keyfi bir değer kabul ediliyordu
             // (bkz. mimari denetim — üçüncü tur).
             data.olusturmaTarihi is timestamp &&
             data.sonGuncelleme is timestamp &&
             (!data.keys().hasAny(['retSebebi']) || data.retSebebi == null || (data.retSebebi is string && data.retSebebi.size() <= 500)) &&
             // mazeretPlanSenkronEdildi/vekaletPlanSenkronEdildi kasitli olarak
             // AYRI iki alan — ikisi eskiden tek bir paylasilan
             // planSenkronEdildi alanini kullaniyordu, bu da bir bildirim
             // once vekaletle sonra mazeretle (ya da tam tersi) el
             // degistirdiginde ikinci olayin "zaten islenmis" sanilip
             // sessizce atlanmasina yol aciyordu (bkz. mimari denetim Y2).
             (!data.keys().hasAny(['mazeretPlanSenkronEdildi']) || data.mazeretPlanSenkronEdildi is bool) &&
             (!data.keys().hasAny(['vekaletPlanSenkronEdildi']) || data.vekaletPlanSenkronEdildi is bool) &&
             (!data.keys().hasAny(['devirSonucu']) || data.devirSonucu is string) &&
             (!data.keys().hasAny(['asilMazeretUid']) || data.asilMazeretUid is string) &&
             // cumaMi kasitli olarak opsiyonel: eski (bu alan eklenmeden once
             // olusturulmus) belgeler bu alan olmadan da gecerli kalir — bkz.
             // isSelfBildirimUpdate()'teki `!= true` karsilastirmasi.
             (!data.keys().hasAny(['cumaMi']) || data.cumaMi is bool) &&
             (!data.keys().hasAny(['vekaletDevredildi']) || data.vekaletDevredildi is bool);
    }

    // ifade tavanı denetimi (2. tur, İKİ AYRI deneme ölçüldü — ikisi de
    // "1000 ifade" uyarı SAYISINI DEĞİŞTİRMEDİ, 13 → 13, hep aynı satırda):
    // (1) get()'leri paylaştırma (isAdmin/isAssignableDutyUid'in AYNI
    // muezzins belgesini tek `let`'e indirmesi), (2) admin dalını (kendi
    // isSuperAdminEmail get()'i + muezzins get()'i ile en pahalı dal, OR
    // zincirinin İLK dalıydı) EN SONA taşımak — ki bu, self-update/vekalet-
    // kabul dallarından biri eşleştiğinde isAdmin()'in 2 get()'inin HİÇ
    // ÇALIŞMAMASI gerekirdi (CEL `||` soldan sağa kısa devre yapar). İKİ
    // FARKLI çalışma-zamanı optimizasyonunun de ölçülebilir etkisi SIFIR
    // olması, tavanın çalışma-zamanı okuma/kısa-devre davranışıyla değil,
    // muhtemelen kuralın DERLENMİŞ ifade ağacının TOPLAM boyutuyla (tüm 4
    // dalın birleşik terim sayısı, hangi dalın gerçekte çalıştığından
    // bağımsız) ilgili olduğuna işaret ediyor — bu durumda gerçek çözüm
    // gerçek doğrulama mantığını azaltmak/şemayı yeniden tasarlamaktır, ayrı
    // bir kapsamlı görev (bkz. commit mesajı). Admin dalının sona alınması
    // yine de tutuluyor: matematiksel olarak sonucu değiştirmez, ama gerçek
    // üretimde (emülatör dışı) her self-update/vekalet-kabul yazımında
    // isAdmin()'in 2 gereksiz Firestore okumasını atlatır.
    match /bildirimler/{docId} {
      allow read, list: if isSignedIn();
      allow create: if isAdmin() && isValidBildirim(incoming());
      allow update: if isSignedIn() && (
        isSelfBildirimUpdate(docId) ||
        isAcceptedVekaletBildirimTransfer(docId) ||
        isBackupPromotionFromMazeret() ||
        (isAdmin() && isValidBildirim(incoming()))
      );
      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------
    // ENTITY: Mazeret Detayları
    // ---------------------------------------------------------
    // bildirimler.retSebebi (özel mazeret/ret gerekçesi metni) buradan
    // taşındı (bkz. isSelfBildirimUpdate yorumu, mimari denetim — altıncı
    // tur) — Firestore alan bazında değil BELGE bazında güvenlik
    // sağladığından, bildirimler `allow read: if isSignedIn()` ile (haftalık
    // çizelgeyi TÜM ekibin görebilmesi için GEREKLİ) açık kalmak zorundaydı,
    // bu da retSebebi'yi de istemeden herkese açıyordu. Bu koleksiyon
    // yalnızca ilgili kişi + admin tarafından okunabilir; doc ID karşılık
    // geldiği bildirimler belgesiyle AYNI deterministik ID'yi kullanır
    // (haftaId_tarih_vakit_tip) — src/services/mazeretServisi.ts'in zaten
    // sahip olduğu bildirimId parametresi doğrudan kullanılır.
    function isValidMazeretDetay(data) {
      return data.keys().hasAll(['uid', 'retSebebi', 'olusturmaTarihi']) &&
             data.keys().hasOnly(['uid', 'retSebebi', 'olusturmaTarihi']) &&
             data.uid is string &&
             data.retSebebi is string && data.retSebebi.size() > 0 && data.retSebebi.size() <= 500 &&
             data.olusturmaTarihi is timestamp;
    }

    match /mazeret_detaylari/{bildirimId} {
      // `resource == null` dali: admin olmayan bir kullanici var olmayan bir
      // mazeret_detaylari ID'sine getDoc atarsa `resource` null olur;
      // eskiden `resource.data.uid` null-deref hatasiyla reddediliyordu
      // (bkz. vekalet_talepleri/izinler get kurallarindaki ayni sinif bug,
      // e2e denetimi — bu koleksiyonda henuz gercek bir non-admin cagiran
      // yok ama desen tutarliligi ve savunma derinligi icin duzeltildi).
      allow get: if isAdmin() || resource == null || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow list: if isAdmin();
      allow create: if isSignedIn() && isValidMazeretDetay(incoming()) && incoming().uid == request.auth.uid;
      // Sabit kayıt — mazeret bir kez bildirilir, değişmez.
      allow update, delete: if false;
    }

    // ---------------------------------------------------------
    // ENTITY: Vekalet Talepleri
    // ---------------------------------------------------------
    match /vekalet_talepleri/{talepId} {
      // `resource == null` dalı şart: vekaletTeklifEt henüz var olmayan bir
      // talep ID'sine (ilk teklif) `getDoc` ile önceden reddedilmiş bir kaydı
      // temizlemek için bakar (bkz. vekaletServisi.ts). Belge yoksa `resource`
      // null olur; eskiden `isVekaletParticipant(existing())` bu durumda
      // `null.gonderenUid` erişimiyle hata fırlatıp isteği reddediyordu —
      // admin olmayan HİÇBİR kullanıcı ilk kez teklif gönderemiyordu (bu
      // sadece bir emülatör kusuru değil: PRODUCTION'da da `isAdmin()` false
      // dönüp `existing()` null-deref hatasıyla sonuçlanınca istek reddedilir
      // — talep henüz yokken varlığını kontrol etmek dahi engelleniyordu).
      // Bir talebin YOK OLMASI hassas bilgi değil (`izinler` L783'teki aynı
      // `resource == null` deseniyle simetrik) — bu yüzden yok-belge durumu
      // koşulsuz izinli, yalnızca VAR OLAN bir talep katılımcı kısıtına tabi.
      allow get: if isAdmin() || resource == null || isVekaletParticipant(existing());
      allow list: if isAdmin() || isVekaletParticipant(existing());
      allow create: if isSignedIn() && isValidVekaletCreate(talepId);
      allow update: if isAdmin() || isRecipientVekaletStatusUpdate();
      // 'reddedildi' de silinebilir olmalı: talep ID'si deterministik
      // (haftaId_tarih_vakit_tip_aliciUid) olduğundan, reddedilen bir talep
      // silinmeden aynı kişiye bir daha teklif gönderilemiyordu — setDoc bu
      // durumda create değil update sayılır ve isValidVekaletCreate/
      // isRecipientVekaletStatusUpdate hiçbiri eşleşmediği için kalıcı
      // kilitleniyordu (bkz. mimari denetim O7).
      allow delete: if isAdmin() || (isSignedIn() && existing().gonderenUid == request.auth.uid && existing().durum in ['beklemede', 'reddedildi']);
    }

    // ---------------------------------------------------------
    // ENTITY: Admin Uyarilari
    // ---------------------------------------------------------
    match /adminUyarilari/{docId} {
      // Admin her belgeyi görür/yazar. Oturum açmış müezzinler ise yalnızca
      // ÇÖZÜLMEMİŞ uyarıları görebilir (bkz. tasarım denetimi: saha müezzini
      // sistem arızasından tamamen habersiz kalıyordu) — çözüm notları ve
      // geçmiş kayıtlar admin'e özel kalır.
      allow read: if isAdmin() || (isSignedIn() && existing().cozuldu == false);
      allow write: if isAdmin();
    }

    // ---------------------------------------------------------
    // ENTITY: Sistem Günlükleri ve Hata Raporları
    // ---------------------------------------------------------
    // Alan/boyut sınırları, tek bir bozuk/kötü niyetli istemcinin sınırsız
    // büyüyen belgelerle günlük Firestore yazma kotasını (Spark plan) veya
    // 1 GB depolama sınırını tüketmesini engeller.
    function isValidErrorLog(data) {
      return data.keys().hasAll(['errorMessage', 'errorStack', 'componentStack', 'userId', 'device', 'breadcrumbs', 'stateSnapshot', 'timestamp']) &&
             data.userId == request.auth.uid &&
             data.errorMessage is string && data.errorMessage.size() <= 2000 &&
             data.errorStack is string && data.errorStack.size() <= 8000 &&
             data.componentStack is string && data.componentStack.size() <= 8000 &&
             data.device is map &&
             data.breadcrumbs is list && data.breadcrumbs.size() <= 30 &&
             data.stateSnapshot is map &&
             data.timestamp is timestamp;
    }

    match /error_logs/{docId} {
      allow create: if isSignedIn() && isValidErrorLog(incoming());
      allow read, write: if isAdmin();
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll(['actionType', 'targetName', 'details', 'userId', 'userDisplayName', 'timestamp']) &&
             data.keys().hasOnly(['actionType', 'targetName', 'details', 'userId', 'userDisplayName', 'timestamp']) &&
             data.actionType is string && data.actionType.size() > 0 && data.actionType.size() <= 80 &&
             data.targetName is string && data.targetName.size() > 0 && data.targetName.size() <= 160 &&
             data.details is string && data.details.size() > 0 && data.details.size() <= 500 &&
             data.userId == request.auth.uid &&
             data.userDisplayName is string && data.userDisplayName.size() > 0 && data.userDisplayName.size() <= 120;
    }

    match /audit_logs/{docId} {
      allow get, list: if isAdmin();
      allow create: if isSignedIn() && isValidAuditLog(incoming());
      allow update, delete: if false;
    }

    function isValidTelemetryLog(data) {
      return data.keys().hasAll(['eventType', 'eventName', 'userId', 'metadata', 'timestamp']) &&
             data.userId == request.auth.uid &&
             data.eventType in ['page_view', 'click', 'error', 'performance'] &&
             data.eventName is string && data.eventName.size() <= 200 &&
             data.metadata is map &&
             data.timestamp is timestamp;
    }

    match /telemetry_logs/{docId} {
      allow create: if isSignedIn() && isValidTelemetryLog(incoming());
      allow read, write: if isAdmin();
    }

    // ---------------------------------------------------------
    // ENTITY: Config & Settings
    // ---------------------------------------------------------
    match /config/{docId} {
      allow read: if isSignedIn();
      // config/bootstrap superAdminEmails listesini tutar. isAdmin() burada
      // KULLANILAMAZ: isAdmin() siradan role=='admin' kullanicilarini da
      // kapsadigindan, yazima izin verilirse herhangi bir admin kendini
      // listeye ekleyip kalici bir super-admin arka kapisi acabilir, hatta
      // gercek super-adminleri listeden cikarabilir (bkz. mimari denetim K2).
      // Bu belge yalnizca admin SDK ile (scripts/seedSuperAdminConfig.ts)
      // yazilir; SDK guvenlik kurallarini atladigi icin bu kisitlama onu
      // etkilemez.
      allow write: if false;
    }

    function isValidSystemSettings(data) {
      return data.keys().hasAll(['ilceId', 'ilceAdi', 'hicriDuzeltme']) &&
             data.keys().hasOnly(['ilceId', 'ilceAdi', 'hicriDuzeltme']) &&
             data.ilceId is string && data.ilceId.size() >= 3 && data.ilceId.size() <= 8 &&
             data.ilceId.matches('^[0-9]+$') &&
             data.ilceAdi is string && data.ilceAdi.size() >= 2 && data.ilceAdi.size() <= 80 &&
             data.hicriDuzeltme is int &&
             data.hicriDuzeltme >= -2 &&
             data.hicriDuzeltme <= 2;
    }

    match /settings/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() && docId == 'system' && isValidSystemSettings(incoming());
    }

    // ---------------------------------------------------------
    // ENTITY: Izinler
    // ---------------------------------------------------------
    // İzin (leave) tarih aralığının bir Cuma içerip içermediğini saf tarih
    // aritmetiğiyle hesaplar. Bu kısıtlamanın istemci tarafı karşılığı
    // (VacationRequestCard.tsx'teki `hasFriday` döngüsü) daha önce SUNUCU
    // tarafında hiç doğrulanmıyordu — bildirimler/vekalet_talepleri'ndeki
    // Cuma kısıtlamasının aksine (bkz. cumaMiIsaretli), izin oluşturma
    // isteğini gönderen taraf ile kısıtlamadan kaçınmak isteyen taraf AYNI
    // kişi olduğundan, bildirimler'deki gibi istemcinin hesapladığı bir
    // bayrağa (`cumaMi` benzeri) güvenmek gerçek bir doğrulama olmazdı — o
    // bayrağı DevTools'tan trivially `false` göndererek kısıtlama tamamen
    // atlatılabilirdi.
    //
    // Firestore Rules'ta ne döngü ne de bir `timestamp(string)` ayrıştırıcısı
    // var (denendi, emülatörde "Function not found" ile reddedildi) — bu
    // yüzden "YYYY-MM-DD" güne, Howard Hinnant'ın bilinen "days_from_civil"
    // takvim formülüyle (yalnızca +,-,*,/ operatörleri) saf tamsayı
    // aritmetiğiyle epoch-gün sayısına çevrilir. 1970-01-01 bir Perşembe
    // olduğundan epoch-gün sayısının mod 7'si 1 olması o günün Cuma
    // olduğu anlamına gelir; aralığın başlangıcından bir sonraki Cuma'ya
    // kalan gün sayısı aralık uzunluğunu aşmıyorsa aralık bir Cuma içerir.
    function epochGunSayisi(tarihStr) {
      let parcalar = tarihStr.split('-');
      let y0 = int(parcalar[0]);
      let m0 = int(parcalar[1]);
      let d0 = int(parcalar[2]);
      // Şubat'ı yılın son ayı sayan takvim kaydırması (Hinnant formülü) —
      // gerçekçi tarihler (y0 > 0) için era/yoe hep pozitif kalır.
      let y = y0 - (m0 <= 2 ? 1 : 0);
      let era = y / 400;
      let yoe = y - era * 400;
      let mAdj = m0 + (m0 > 2 ? -3 : 9);
      let doy = (153 * mAdj + 2) / 5 + d0 - 1;
      let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
      return era * 146097 + doe - 719468;
    }

    function izinAraligiCumaIceriyorMu(baslangic, bitis) {
      let startDay = epochGunSayisi(baslangic);
      let endDay = epochGunSayisi(bitis);
      let rangeDays = endDay - startDay;
      let gunlerCumayaKadar = (1 - (startDay % 7) + 7) % 7;
      return rangeDays >= 0 && gunlerCumayaKadar <= rangeDays;
    }

    // Tarih-aralığı şekil/iş-kuralı doğrulamasını `isValidIzin`'den ayrı bir
    // fonksiyona çıkarır — `isValidIzin`'in uid/durum sabitleri (kendi
    // isteğini oluşturan/düzenleyen kullanıcıya özgü) admin onarım yoluna
    // (bkz. `izinler` update kuralı, admin disjunct'ı) uygulanamaz; admin
    // veriOnarimServisi.ts üzerinden BAŞKASININ ters-tarihli izin kaydını
    // düzeltirken ne kendi uid'i eşleşir ne kayıt 'onay_bekliyor' durumunda
    // olmak zorundadır (bkz. mimari denetim — üçüncü tur).
    function isValidIzinTarihAraligi(baslangic, bitis) {
      return baslangic is string && baslangic.size() == 10 &&
             bitis is string && bitis.size() == 10 &&
             // Ters çevrilmiş aralık (bitis < baslangic) mantıksız veri —
             // planlamaCekirdegi.ts'in string karşılaştırmasında zararsız
             // kalsa da (hiçbir güne eşleşmez) sunucu tarafında reddedilmesi
             // daha temiz.
             bitis >= baslangic &&
             !izinAraligiCumaIceriyorMu(baslangic, bitis);
    }

    function isValidIzin(data) {
      return data.keys().hasAll(['uid', 'baslangic', 'bitis', 'tip', 'durum', 'olusturmaTarihi']) &&
             // Diğer tüm şema doğrulayıcıları (isValidMuezzin, isValidBildirim,
             // isValidVekaletTalebi vb.) alan setini hasOnly ile sınırlıyor —
             // isValidIzin bunu atlıyordu, VacationRequestCard.tsx'in
             // gönderdiği `sebep` dahil herhangi bir ekstra/sınırsız-uzunlukta
             // alan sessizce kabul ediliyordu (bkz. mimari denetim — üçüncü
             // tur). `redSebebi` opsiyonel (admin red gerekçesi) ama izinler
             // update kuralının self-update dalı isValidIzin'i çağırdığından
             // burada da izinli olmalı.
             data.keys().hasOnly(['uid', 'baslangic', 'bitis', 'tip', 'sebep', 'durum', 'olusturmaTarihi', 'redSebebi']) &&
             data.uid == request.auth.uid &&
             data.tip in ['haftalik', 'yillik', 'mazeret'] &&
             data.durum == 'onay_bekliyor' &&
             isValidIzinTarihAraligi(data.baslangic, data.bitis) &&
             // `sebep` (VacationRequestCard.tsx'in her zaman gönderdiği izin
             // gerekçesi) hasOnly'de listeleniyordu ama dosyadaki HER diğer
             // serbest metin alanının aksine (baslik, icerik, retSebebi,
             // yazar vb.) hiç tip/uzunluk doğrulaması yoktu — sınırsız
             // uzunlukta veya string olmayan bir değer sessizce kabul
             // ediliyordu (bkz. mimari denetim — altıncı tur, form
             // doğrulama bulguları). Diğer opsiyonel serbest metin
             // alanlarıyla aynı "yoksa serbest, varsa tipli" kalıbı.
             (!data.keys().hasAny(['sebep']) || (data.sebep is string && data.sebep.size() <= 1000));
    }

    match /izinler/{docId} {
      allow list: if isAdmin() || (isSignedIn() && (resource == null || resource.data.durum == 'onaylandi' || resource.data.uid == request.auth.uid));
      // isSignedIn() ortadaki disjunktta da zorunlu — eskiden yalnizca
      // 'onaylandi' durumu kontrol ediliyordu, yani giris yapmamis biri
      // durumu 'onaylandi' olan HERHANGI bir izin belgesini ID'sini
      // bilerek okuyabiliyordu (bkz. mimari denetim O10).
      // `resource == null` dali komsu `list` kuraliyla (yukarida) SIMETRIK
      // olmasi icin eklendi — bu satirda eskiden eksikti: admin olmayan bir
      // kullanici var olmayan bir izin ID'sine getDoc attiginda `resource`
      // null oldugundan `resource.data.durum` null-deref hatasiyla
      // reddediliyordu (bkz. vekalet_talepleri get kuralindaki ayni sinif
      // bug, e2e denetimi — bu koleksiyonda henuz gercek bir cagiran yok
      // ama desen tutarliligi ve savunma derinligi icin duzeltildi).
      allow get: if isAdmin() || (isSignedIn() && (resource == null || resource.data.durum == 'onaylandi' || resource.data.uid == request.auth.uid));
      allow create: if isSignedIn() && isValidIzin(incoming());
      // Admin disjunct'ı önceden yalnızca durum/redSebebi'ye izin veriyordu —
      // src/services/veriOnarimServisi.ts'in ters-tarihli bir izin kaydını
      // düzeltmek için yazdığı baslangic/bitis alanları bu kapsama hiç
      // girmiyordu, yani "Veri Sağlığı" ekranındaki bu onarım her zaman
      // PERMISSION_DENIED ile başarısız oluyordu (bkz. mimari denetim —
      // üçüncü tur). baslangic/bitis'e dokunulduğunda isValidIzinTarihAraligi
      // ile şekil/iş-kuralı korunuyor; dokunulmadığında (yalnızca durum/
      // redSebebi kararı) eskisi gibi serbest.
      allow update: if (isAdmin() &&
                        incoming().diff(existing()).affectedKeys().hasOnly(['durum', 'redSebebi', 'baslangic', 'bitis']) &&
                        (!incoming().diff(existing()).affectedKeys().hasAny(['baslangic', 'bitis']) ||
                         isValidIzinTarihAraligi(incoming().baslangic, incoming().bitis))) ||
                    (isSignedIn() && existing().uid == request.auth.uid && existing().durum == 'onay_bekliyor' && isValidIzin(incoming()));
      allow delete: if isAdmin() || (isSignedIn() && existing().uid == request.auth.uid && existing().durum == 'onay_bekliyor');
    }

    // Default Deny - MUST BE LAST
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
