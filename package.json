  "version": "2.2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "typecheck:scripts": "tsc --noEmit -p tsconfig.scripts.json",
    "lint": "eslint .",
    "test": "npm run test:smoke",
    "test:all": "npm run typecheck && npm run typecheck:scripts && npm run lint && npm run test:smoke && npm run test:unit && npm run test:rules && npm run verify:sw-config",
    "verify:sw-config": "tsx scripts/verify-sw-config.ts",
    "test:e2e": "playwright test",
    "test:rules": "firebase emulators:exec --only firestore \"tsx scripts/firestore-rules-tests.ts\"",
    "test:smoke": "tsx scripts/smoke-tests.ts",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "verify:indexes": "tsx scripts/verify-firestore-indexes.ts",
    "process:mazeret-devirleri": "tsx scripts/mazeretDevirleriniIsle.ts",
    "process:vekalet-devirleri": "tsx scripts/vekaletDevirleriniIsle.ts",
    "seed:super-admin": "tsx scripts/seedSuperAdminConfig.ts",
    "temizle:gunlukler": "tsx scripts/temizleGunlukler.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource/instrument-serif": "^5.2.8",
    "date-fns": "^4.1.0",
    "firebase": "^12.12.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-error-boundary": "^6.1.1",
    "react-router-dom": "^7.14.1",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@google/genai": "^1.29.0",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.1.14",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "dotenv": "^17.2.3",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "express": "^4.21.2",
    "firebase-admin": "^14.1.0",
    "firebase-tools": "^15.23.0",
    "jsdom": "^29.1.1",
    "node-fetch": "^3.3.2",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.63.0",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.1.10"
  }
